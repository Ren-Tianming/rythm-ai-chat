# Application
ENVIRONMENT=development
APP_SECRET=development-only-change-me
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://rythm:change-me@db:5432/rythm_chatbot
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
CORS_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
SESSION_COOKIE_NAME=rythm_session
CSRF_COOKIE_NAME=rythm_csrf
SESSION_IDLE_HOURS=24
SESSION_ABSOLUTE_DAYS=14
LOG_LEVEL=INFO

# LLM providers — never expose these in VITE_* variables
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Abuse protection
TURNSTILE_REQUIRED=false
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
TERMS_VERSION=2026-07-29
VITE_TERMS_VERSION=2026-07-29

# SMTP / Amazon SES SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true

# Usage controls
MAX_INPUT_CHARS=4000
MAX_CONTEXT_CHARS=16000
MAX_OUTPUT_TOKENS=512
CONTEXT_ROUNDS=5
DAILY_CHAT_LIMIT=50
CHAT_PER_MINUTE_LIMIT=5
MAX_CONCURRENT_GENERATIONS_PER_USER=1
GENERATION_TIMEOUT_SECONDS=120
PROVIDER_TIMEOUT_SECONDS=60

# PostgreSQL container
POSTGRES_DB=rythm_chatbot
POSTGRES_USER=rythm
POSTGRES_PASSWORD=change-me

# Host binding. Shared host Nginx proxies chat.rhythmusic.site to this loopback port.
CHATBOT_PORT=8081
