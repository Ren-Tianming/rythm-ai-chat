# Application
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://rythm:change-me@db:5432/rythm_chatbot
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173

# LLM providers — never expose these in VITE_* variables
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Abuse protection
TURNSTILE_REQUIRED=false
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# SMTP / Amazon SES SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true

# Usage controls
MAX_INPUT_CHARS=4000
MAX_OUTPUT_TOKENS=512
CONTEXT_ROUNDS=5
DAILY_CHAT_LIMIT=50

# PostgreSQL container
POSTGRES_DB=rythm_chatbot
POSTGRES_USER=rythm
POSTGRES_PASSWORD=change-me
