ENVIRONMENT=production
APP_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=https://chat.rhythmusic.site
DATABASE_URL=postgresql+asyncpg://rythm:replace-db-password@db:5432/rythm_chatbot
TRUSTED_HOSTS=chat.rhythmusic.site,localhost,127.0.0.1
CORS_ORIGINS=https://chat.rhythmusic.site
CSRF_TRUSTED_ORIGINS=https://chat.rhythmusic.site
COOKIE_SECURE=true
SESSION_COOKIE_NAME=rythm_session
CSRF_COOKIE_NAME=rythm_csrf
SESSION_IDLE_HOURS=24
SESSION_ABSOLUTE_DAYS=14
LOG_LEVEL=INFO

TURNSTILE_REQUIRED=true
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
VITE_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TERMS_VERSION=2026-07-29
VITE_TERMS_VERSION=2026-07-29

SMTP_HOST=email-smtp.ap-northeast-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=noreply@rhythmusic.site
SMTP_USE_TLS=true

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

MAX_INPUT_CHARS=4000
MAX_CONTEXT_CHARS=16000
MAX_OUTPUT_TOKENS=512
CONTEXT_ROUNDS=5
DAILY_CHAT_LIMIT=50
CHAT_PER_MINUTE_LIMIT=5
MAX_CONCURRENT_GENERATIONS_PER_USER=1
GENERATION_TIMEOUT_SECONDS=120
PROVIDER_TIMEOUT_SECONDS=60

POSTGRES_DB=rythm_chatbot
POSTGRES_USER=rythm
POSTGRES_PASSWORD=replace-db-password
CHATBOT_PORT=8081
